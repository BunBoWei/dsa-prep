class Solution(object):
    def permute(self, nums):
        num_set = set()
        result = []
        def permute_helpler(num_set, index):
            print(num_set)
            if len(num_set) == len(nums):
                result.append(list(num_set))
                return
            num_set.add(nums[index])
            for i in range(index, len(nums)-1):
                permute_helpler(num_set, i+1)
                num_set.pop()
            return num_set
        permute_helpler(num_set, nums[0])
        return result

solution = Solution()
